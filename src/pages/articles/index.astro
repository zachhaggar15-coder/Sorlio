---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<BaseLayout
  title="All guides"
  description="Every Sorlio Guides article: comparisons of French-learning apps, study methods and French reading practice."
  path="/articles/"
  current="guides"
>
  <div class="prose-wrap">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'All guides' }]} />
    <h1>All guides</h1>
    <p class="lede">Articles on French learning, reading practice and choosing an app.</p>
    <ul class="cards">
      {guides.map((g) => <GuideCard entry={g} />)}
    </ul>
  </div>
</BaseLayout>
