---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS } from '../lib/categories';

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const { data } = entry;
---
<li class="card" data-cat={data.category}>
  <p class="eyebrow">{CATEGORY_LABELS[data.category]}</p>
  <h3><a href={`/${entry.id}/`}>{data.title}</a></h3>
  <p>{data.description}</p>
  <p class="meta">Updated {data.updatedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
</li>
